# 카카오 developers(https://developers.kakao.com)에서 발급한 REST API 키
# 비워두면 OpenStreetMap 데이터로 자동 전환됩니다.
KAKAO_REST_API_KEY=
# 카카오 developers → 앱 키 → JavaScript 키 (카카오맵 표시용). 플랫폼 > Web에 http://localhost:3000 등록 필요
# 비워두면 OpenStreetMap 지도를 사용합니다.
KAKAO_JS_KEY=
# 카카오 로그인 Client Secret ("사용함"으로 설정했을 때만)
KAKAO_CLIENT_SECRET=

# 네이버 로그인 (developers.naver.com) — Callback: http://localhost:3000/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 로그인 (console.cloud.google.com) — 리디렉션 URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=3000

# Google Stitch API 키 (scripts/stitch.js 로 디자인 생성할 때만 필요)
STITCH_API_KEY=

# 구글 별점·리뷰 (Places API New, 유료 — 가게를 눌렀을 때만 호출)
GOOGLE_PLACES_API_KEY=
